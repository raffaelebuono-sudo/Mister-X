# JARVIS – API Keys
# Diese Datei nach `.env` kopieren und Werte einfügen.

# Pflicht: Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Optional: ElevenLabs für natürliche deutsche Stimme
# Wenn leer, nutzt JARVIS den macOS 'say'-Befehl als Fallback
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: Tavily Web-Suche (Phase 3)
TAVILY_API_KEY=
