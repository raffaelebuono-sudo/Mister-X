# JARVIS – API Keys
# Diese Datei nach `.env` kopieren und Werte einfügen.

# Pflicht: Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs – Premium-Stimme (sehr empfohlen, klingt menschlich).
# NUR der Key nötig; Stimme wird automatisch gewählt. Key holen:
# https://elevenlabs.io → Profil → API Key (Gratis-Kontingent vorhanden)
ELEVENLABS_API_KEY=
# Optional: bestimmte Stimme erzwingen (Voice-ID aus elevenlabs.io)
ELEVENLABS_VOICE_ID=

# Optional: Tavily Web-Suche (Phase 3)
TAVILY_API_KEY=

# Aktivierung: "code" (Standard, Code im Terminal) oder "voice"
JARVIS_ACTIVATION_MODE=code
# Dein persönlicher Aktivierungs-Code (Zahlenkombination)
JARVIS_ACTIVATION_CODE=1234

# Optional: Multi-Cloud-Fallback (wenn Claude/Anthropic ausfällt).
# Einer reicht; beide = doppelte Absicherung. Gleiche Qualitätsklasse.
# Diese Keys nutzt auch das Anime-Studio für die BILD-Generierung
# (echte Anime-Bilder pro Szene). Einer davon genügt.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Anime-Studio (optional)
# Bild-Anbieter: auto (Standard) | openai | gemini
IMAGE_PROVIDER=auto

# Bewegte KI-Video-Clips + KI-Musik (Replicate) – "KI-Maximum".
# Ein Token genügt für beides. Achtung: Clips sind langsam und kosten extra.
REPLICATE_API_TOKEN=
# Modelle überschreiben (optional):
# REPLICATE_VIDEO_MODEL=kwaivgi/kling-v1.6-standard
# REPLICATE_MUSIC_MODEL=meta/musicgen

# Echte Charakter-Konsistenz per LoRA-Feintuning (Studio-Weg).
# Braucht zusätzlich deinen Replicate-Benutzernamen – das trainierte
# Figur-Modell wird privat auf deinem Account gespeichert.
# Training ist langsam (~10-20 Min/Figur) und kostet GPU-Zeit.
REPLICATE_USERNAME=
# REPLICATE_LORA_TRAINER=ostris/flux-dev-lora-trainer
# REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell
# REPLICATE_LORA_STEPS=1000
# Modelle überschreiben (Standardwerte sind meist passend):
# OPENAI_IMAGE_MODEL=gpt-image-1
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
# Story-Modell und Port:
# ANIME_MODEL=claude-sonnet-4-6
# ANIME_PORT=8800
