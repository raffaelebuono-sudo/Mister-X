<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvis.assistant</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__PROJECT__/main.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Voll autonom: IMMER neu starten, auch nach sauberem Exit.
         Ein 24/7-Assistent ist nie "fertig". -->
    <key>KeepAlive</key>
    <true/>

    <!-- Mindestens 10s zwischen Neustarts, verhindert Crash-Schleifen. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__PROJECT__/data/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT__/data/logs/launchd.err.log</string>
</dict>
</plist>
